rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }

    function myEmail() { return request.auth.token.email.lower(); }

    match /users/{uid} {
      allow get: if signedIn();
      allow write: if signedIn() && me() == uid
        && request.resource.data.email == myEmail();
    }

    // Dispositivo que tiene la cuenta abierta (sesión única).
    match /sessions/{uid} {
      allow read, write: if signedIn() && me() == uid;
    }

    match /emailIndex/{email} {
      allow get: if signedIn();
      allow create, update: if signedIn() && email == myEmail()
        && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid']);
    }

    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && request.resource.data.from == me()
        && id == me() + '_' + request.resource.data.to
        && request.resource.data.to != me()
        && request.resource.data.status == 'pending'
        && request.resource.data.fromPerson.uid == me()
        && request.resource.data.fromPerson.email == myEmail()
        && request.resource.data.toPerson.uid == request.resource.data.to
        && request.resource.data.keys().hasOnly(['from', 'to', 'fromPerson', 'toPerson', 'status', 'createdAt']);
      allow update: if signedIn() && me() == resource.data.to
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    match /expenses/{id} {
      allow read: if signedIn() && me() in resource.data.participants;
      allow create: if signedIn() && request.resource.data.createdBy == me()
        && me() in request.resource.data.participants;
      allow update: if signedIn() && (
        (me() == resource.data.createdBy && request.resource.data.createdBy == me())
        || (me() in resource.data.participants
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['settled', 'updatedAt'])));
      allow delete: if signedIn() && me() == resource.data.createdBy;
    }

    // Wallet de cada cuenta: solo su dueña.
    match /wallets/{uid} {
      allow read, write: if signedIn() && me() == uid;
      match /{box}/{id} {
        allow read, write: if signedIn() && me() == uid;
      }
    }
  }
}
